[Unit]
Description=h2kvm VM Conversion Daemon (%i instance)
Documentation=https://github.com/zyvorai/h2kvm
After=network.target
PartOf=h2kvm.target

[Service]
Type=simple
User=h2kvm
Group=h2kvm

# Environment configuration (instance-specific)
EnvironmentFile=-/etc/h2kvm/h2kvm.conf
EnvironmentFile=-/etc/h2kvm/h2kvm-%i.conf

# Working directories
WorkingDirectory=/var/lib/h2kvm/%i
StateDirectory=h2kvm/%i
StateDirectoryMode=0755
CacheDirectory=h2kvm/%i
CacheDirectoryMode=0755
LogsDirectory=h2kvm/%i
LogsDirectoryMode=0755

# Runtime directories
RuntimeDirectory=h2kvm-%i
RuntimeDirectoryMode=0755

# Watch and output directories (instance-specific)
Environment="WATCH_DIR=/var/lib/h2kvm/%i/queue"
Environment="OUTPUT_DIR=/var/lib/h2kvm/%i/output"
Environment="LOG_LEVEL=info"
Environment="INSTANCE_NAME=%i"

# Binary path (update this to match your installation)
ExecStart=/usr/local/bin/h2kvm daemon \
    --instance=%i \
    --watch-dir=${WATCH_DIR} \
    --output-dir=${OUTPUT_DIR} \
    --log-level=${LOG_LEVEL}

# Restart policy
Restart=on-failure
RestartSec=5s

# Resource limits (can be overridden in instance config)
MemoryMax=4G
MemoryHigh=3G
CPUQuota=200%

# Timeout for start and stop
TimeoutStartSec=30s
TimeoutStopSec=30s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/h2kvm/%i /var/log/h2kvm/%i
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Capabilities (needed for QEMU operations)
AmbientCapabilities=CAP_DAC_OVERRIDE CAP_FOWNER

[Install]
WantedBy=multi-user.target
WantedBy=h2kvm.target
# Compat: "systemctl enable" also creates a hyper2kvm@.service symlink so
# tooling/scripts written against the pre-rename unit name keep working.
Alias=hyper2kvm@%i.service
