[Unit]
Description=h2kvm VM Conversion Daemon (Default Instance)
Documentation=https://github.com/zyvorai/h2kvm
After=network.target

[Service]
Type=simple
User=h2kvm
Group=h2kvm

# Environment configuration
EnvironmentFile=-/etc/h2kvm/h2kvm.conf

# Working directories
WorkingDirectory=/var/lib/h2kvm
StateDirectory=h2kvm
StateDirectoryMode=0755
CacheDirectory=h2kvm
CacheDirectoryMode=0755
LogsDirectory=h2kvm
LogsDirectoryMode=0755

# Runtime directories
RuntimeDirectory=h2kvm
RuntimeDirectoryMode=0755

# Watch and output directories
Environment="WATCH_DIR=/var/lib/h2kvm/queue"
Environment="OUTPUT_DIR=/var/lib/h2kvm/output"
Environment="LOG_LEVEL=info"

# Binary path (update this to match your installation)
ExecStart=/usr/local/bin/h2kvm daemon \
    --watch-dir=${WATCH_DIR} \
    --output-dir=${OUTPUT_DIR} \
    --log-level=${LOG_LEVEL}

# Restart policy
Restart=on-failure
RestartSec=5s

# Resource limits
MemoryMax=4G
MemoryHigh=3G
CPUQuota=200%

# Timeout for start and stop
TimeoutStartSec=30s
TimeoutStopSec=30s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/h2kvm /var/log/h2kvm
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Capabilities (needed for QEMU operations)
AmbientCapabilities=CAP_DAC_OVERRIDE CAP_FOWNER

[Install]
WantedBy=multi-user.target
# Compat: "systemctl enable" also creates a hyper2kvm.service symlink so
# tooling/scripts written against the pre-rename unit name keep working.
Alias=hyper2kvm.service
